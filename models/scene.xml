<mujoco model="ur3_pick_scene">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
  </visual>
 
  <include file="ur3/ur3.xml"/>
 
  <worldbody>
    <light pos="0.3 0 1.5" dir="0 0 -1" diffuse="0.6 0.6 0.6" castshadow="false"/>
    <light pos="-0.5 0.5 1.2" dir="0.3 -0.3 -1" diffuse="0.3 0.3 0.3" castshadow="false"/>
    <!-- Table: top surface at z = 0, robot base mounted on it at the origin -->
    <geom name="table" type="box" pos="0.2 0 -0.02" size="0.6 0.6 0.02" rgba="0.75 0.7 0.6 1"/>
    <geom name="floor" type="plane" pos="0 0 -0.04" size="2 2 0.1" rgba="0.3 0.3 0.3 1"/>
    <!-- Target: red 4 cm cube. Pose is overwritten each trial by sim/randomise.py -->
    <body name="target" pos="0.3 0 0.02">
      <freejoint name="target_free"/>
      <geom name="target_geom" type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0.9 0.1 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
